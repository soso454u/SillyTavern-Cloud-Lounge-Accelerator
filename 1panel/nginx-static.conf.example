# 放入 1Panel 网站 -> 配置 -> 配置文件的 server { ... } 内。
# 如 SillyTavern 上游不是 127.0.0.1:8000，请把下方 proxy_pass 改成你现有反代的上游。
# 不要对 /api、/characters、/backgrounds 或 /thumbnail 使用这段规则。

gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_comp_level 5;
gzip_types
    application/javascript
    application/json
    application/manifest+json
    application/wasm
    image/svg+xml
    text/css
    text/plain;

location ~* ^/(?:script\.js|style\.css|lib\.js|favicon\.ico|manifest\.json|css/|img/|lib/|locales/|scripts/|sounds/|webfonts/) {
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_hide_header Cache-Control;
    proxy_hide_header Expires;
    expires 1h;
    add_header Cache-Control "public, max-age=3600, stale-while-revalidate=86400" always;
}
